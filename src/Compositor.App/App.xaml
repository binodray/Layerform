<Application
    x:Class="Compositor.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- macOS's default blue accent, whatever accent Windows uses. -->
            <Color x:Key="SystemAccentColor">#FF0A84FF</Color>
            <Color x:Key="SystemAccentColorLight1">#FF3395FF</Color>
            <Color x:Key="SystemAccentColorLight2">#FF5CA9FF</Color>
            <Color x:Key="SystemAccentColorLight3">#FF85BEFF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF0A74E0</Color>
            <Color x:Key="SystemAccentColorDark2">#FF0963C0</Color>
            <Color x:Key="SystemAccentColorDark3">#FF0852A0</Color>

            <!-- Compositor's dark palette (the Mac app's white levels). -->
            <Color x:Key="WindowBackgroundColor">#FF242424</Color>
            <Color x:Key="CanvasBackgroundColor">#FF1B1B1B</Color>
            <Color x:Key="DividerColor">#FF383838</Color>
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
            <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="{StaticResource CanvasBackgroundColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF9A9A9E" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#FF6C6C70" />

            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
            <x:Double x:Key="TextControlThemeMinHeight">26</x:Double>
            <Thickness x:Key="TextControlThemePadding">7,3,6,4</Thickness>
            <x:Double x:Key="ComboBoxMinHeight">26</x:Double>
            <Thickness x:Key="ComboBoxPadding">10,3,0,4</Thickness>
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

            <!-- Capsule buttons, as the Mac app's roundedControls() gives every bordered button. -->
            <Style x:Key="CapsuleButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="Padding" Value="12,3,12,4" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="AccentCapsuleButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="Padding" Value="14,3,14,4" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="PlainIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#14FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#26FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Content.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
